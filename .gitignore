# ============================================================
# .gitignore — 华为VRP基线检查工具
# ============================================================

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# ---- 运行时生成的报告 ----
remediation_report.md
baseline_report.xlsx

# ---- 打包产物 ----
*.tar.gz

# ---- runtime/ Python独立运行时 (体积大, 不提交) ----
runtime/

# ---- vendor_web/ 临时目录 ----
vendor_web/

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Docker 数据卷 ----
data/
