# ============================================================
# .gitignore — 华为VRP基线检查工具
# ============================================================

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# ---- 运行时生成的报告 ----
remediation_report.md
baseline_report.xlsx
output/

# ---- 设备配置快照 ----
# 快照含设备全量配置, 属敏感资产, 默认不入库;
# 仅保留随包发布的脱敏样例。
snapshots/*
!snapshots/10.10.1.11.cfg
!snapshots/sample.cfg

# ---- 含明文口令的设备清单 ----
# 模板见 devices.csv.example, 本地复制为 devices.csv 后填写
devices.csv

# ---- 打包产物 ----
*.tar.gz

# ---- runtime/ Python独立运行时 (体积大, 不提交) ----
runtime/

# ---- vendor_web/ 临时目录 ----
vendor_web/

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Docker 数据卷 ----
data/
